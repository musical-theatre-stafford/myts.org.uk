---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Programme from '../../components/Programme.astro';
import Gallery from '../../components/Gallery.astro';
import NodaBadge from '../../components/NodaBadge.astro';
import ExtIcon from '../../components/ExtIcon.astro';
import photoManifest from '../../data/photo-manifest.json';
import nodaData from '../../data/noda.json';
import nodaReports from '../../data/noda-reports.json';
import { MEDIA, SITE } from '../../consts';

const programmeFiles = import.meta.glob('../../data/archive/*.json', { eager: true });

export async function getStaticPaths() {
  const shows = await getCollection('shows');
  return shows.map(s => ({ params: { slug: s.id }, props: { show: s } }));
}

const { show } = Astro.props;
const { Content } = await render(show);

const slug = show.id;
const programme: any =
  (Object.entries(programmeFiles).find(([k]) => k.endsWith(`/${slug}.json`))?.[1] as any)?.default ?? null;
const photos: any[] = (photoManifest as any).shows?.[slug]?.photos ?? [];
const pdf: string | null = (photoManifest as any).shows?.[slug]?.pdf ?? null;
const pdfUrl = pdf ? `${MEDIA.base}/${slug}/${pdf}` : null;
const noda = (nodaData as Record<string, 'nominated' | 'awarded'>)[slug] ?? null;
const nodaReport = (nodaReports as Record<string, string>)[slug] ?? null;

const now = new Date();
const start = show.data.dates_start;
const end = show.data.dates_end ?? start;
let status: 'upcoming' | 'current' | 'past' = show.data.status ?? 'past';
if (!show.data.status) {
  if (now < start) status = 'upcoming';
  else if (now >= start && now <= new Date(end.getTime() + 24*60*60*1000)) status = 'current';
  else status = 'past';
}

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const dateLabel = end.getTime() !== start.getTime() ? `${fmt(start)} – ${fmt(end)}` : fmt(start);

// Poster as the page's social share image (absolute URL).
const posterUrl = show.data.poster
  ? new URL((show.data.poster as any).src, Astro.site ?? SITE.url).toString()
  : undefined;

// Structured data so search engines can show the production as an event
// (name, dates, venue, tickets) — helps rich results, especially for upcoming shows.
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'TheaterEvent',
  name: show.data.title,
  startDate: start.toISOString().slice(0, 10),
  endDate: end.toISOString().slice(0, 10),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: show.data.venue,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Stafford',
      addressRegion: 'Staffordshire',
      addressCountry: 'GB',
    },
  },
  organizer: { '@type': 'Organization', name: SITE.title, url: SITE.url },
  performer: { '@type': 'PerformingGroup', name: SITE.title },
  ...(posterUrl ? { image: [posterUrl] } : {}),
  ...(show.data.blurb ? { description: show.data.blurb } : {}),
  ...(show.data.ticket_url
    ? { offers: { '@type': 'Offer', url: show.data.ticket_url, availability: 'https://schema.org/InStock' } }
    : {}),
};
---
<BaseLayout title={show.data.title} description={show.data.blurb ?? `${show.data.title} at ${show.data.venue}, ${dateLabel}`} ogImage={posterUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href="/shows/">&larr; All shows</a></p>
    </div>
    <div class="container detail">
      {show.data.poster && (
        <div class="poster">
          <Image src={show.data.poster} alt={`${show.data.title} poster`} width={800} height={1067} />
          {show.data.photographer && <p class="photo-credit">Photos: {show.data.photographer}</p>}
        </div>
      )}
      <div class="body">
        <div class="eyebrow-row">
          <p class="eyebrow">{status === 'past' ? 'Past production' : status === 'current' ? 'On now' : 'Upcoming'}</p>
          {noda && <NodaBadge status={noda} />}
        </div>
        <h1>{show.data.title}</h1>
        <p class="meta"><strong>{dateLabel}</strong> &middot; {show.data.venue}</p>
        {show.data.blurb && <p class="lede">{show.data.blurb}</p>}
        <div class="prose">
          <Content />
        </div>
        {show.data.ticket_url && status !== 'past' && (
          <p><a class="btn btn-primary" href={show.data.ticket_url} target="_blank" rel="noopener">Book tickets</a></p>
        )}
        {(pdfUrl || nodaReport) && (
          <div class="detail-actions">
            {pdfUrl && (
              <a class="btn btn-primary" href={pdfUrl} target="_blank" rel="noopener">
                Download the programme (PDF)<ExtIcon />
              </a>
            )}
            {nodaReport && (
              <a class="btn btn-outline" href={nodaReport} target="_blank" rel="noopener">
                NODA show report<ExtIcon />
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    {programme && (
      <div class="container">
        <Programme data={programme} />
      </div>
    )}
    {photos.length > 0 && (
      <div class="container">
        <Gallery slug={slug} photos={photos} />
      </div>
    )}

    <div class="container">
      <p style="margin-top:2.5rem;"><a href="/shows/">&larr; All shows</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 380px) 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 780px) {
    .detail { grid-template-columns: 1fr; }
  }
  .poster img { width: 100%; height: auto; border-radius: var(--myts-radius-lg); box-shadow: var(--myts-shadow-lg); }
  .photo-credit { margin-top: 0.5rem; font-size: 0.8rem; color: var(--myts-muted); text-align: right; }
  .meta { color: var(--myts-muted); margin-bottom: 1rem; }
  .lede { font-size: 1.15rem; }
  .prose :global(p) { margin-bottom: 1rem; }
  .body h1 { margin-top: 0.5rem; }
  .eyebrow-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .eyebrow-row .eyebrow { margin-bottom: 0; }
  .breadcrumb { margin-bottom: 1.25rem; font-size: 0.9rem; }
  .breadcrumb a { color: var(--myts-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--myts-primary); }
  /* Programme + NODA-report buttons, under the info column with space above. */
  .detail-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .detail-actions .btn { display: inline-flex; align-items: center; gap: 0.5rem; }
</style>
