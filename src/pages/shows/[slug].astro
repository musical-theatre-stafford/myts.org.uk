---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Programme from '../../components/Programme.astro';
import Gallery from '../../components/Gallery.astro';
import NodaBadge from '../../components/NodaBadge.astro';
import photoManifest from '../../data/photo-manifest.json';
import nodaData from '../../data/noda.json';
import { MEDIA } from '../../consts';

const programmeFiles = import.meta.glob('../../data/archive/*.json', { eager: true });

export async function getStaticPaths() {
  const shows = await getCollection('shows');
  return shows.map(s => ({ params: { slug: s.id }, props: { show: s } }));
}

const { show } = Astro.props;
const { Content } = await render(show);

const slug = show.id;
const programme: any =
  (Object.entries(programmeFiles).find(([k]) => k.endsWith(`/${slug}.json`))?.[1] as any)?.default ?? null;
const photos: any[] = (photoManifest as any).shows?.[slug]?.photos ?? [];
const pdf: string | null = (photoManifest as any).shows?.[slug]?.pdf ?? null;
const pdfUrl = pdf ? `${MEDIA.base}/${slug}/${pdf}` : null;
const noda = (nodaData as Record<string, 'nominated' | 'awarded'>)[slug] ?? null;

const now = new Date();
const start = show.data.dates_start;
const end = show.data.dates_end ?? start;
let status: 'upcoming' | 'current' | 'past' = show.data.status ?? 'past';
if (!show.data.status) {
  if (now < start) status = 'upcoming';
  else if (now >= start && now <= new Date(end.getTime() + 24*60*60*1000)) status = 'current';
  else status = 'past';
}

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const dateLabel = end.getTime() !== start.getTime() ? `${fmt(start)} – ${fmt(end)}` : fmt(start);
---
<BaseLayout title={show.data.title} description={show.data.blurb ?? `${show.data.title} at ${show.data.venue}, ${dateLabel}`}>
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href="/shows/">&larr; All shows</a></p>
    </div>
    <div class="container detail">
      {show.data.poster && (
        <div class="poster">
          <Image src={show.data.poster} alt={`${show.data.title} poster`} width={800} height={1067} />
        </div>
      )}
      <div class="body">
        <div class="eyebrow-row">
          <p class="eyebrow">{status === 'past' ? 'Past production' : status === 'current' ? 'On now' : 'Upcoming'}</p>
          {noda && <NodaBadge status={noda} />}
        </div>
        <h1>{show.data.title}</h1>
        <p class="meta"><strong>{dateLabel}</strong> &middot; {show.data.venue}</p>
        {show.data.blurb && <p class="lede">{show.data.blurb}</p>}
        <div class="prose">
          <Content />
        </div>
        {show.data.ticket_url && status !== 'past' && (
          <p><a class="btn btn-primary" href={show.data.ticket_url} target="_blank" rel="noopener">Book tickets</a></p>
        )}
      </div>
    </div>

    {pdfUrl && (
      <div class="container">
        <p class="prog-pdf">
          <a class="btn btn-primary" href={pdfUrl} target="_blank" rel="noopener">
            Download the programme (PDF)
            <svg class="ext-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </p>
      </div>
    )}
    {programme && (
      <div class="container">
        <Programme data={programme} />
      </div>
    )}
    {photos.length > 0 && (
      <div class="container">
        <Gallery slug={slug} photos={photos} />
      </div>
    )}

    <div class="container">
      <p style="margin-top:2.5rem;"><a href="/shows/">&larr; All shows</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 380px) 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 780px) {
    .detail { grid-template-columns: 1fr; }
  }
  .poster img { width: 100%; height: auto; border-radius: var(--myts-radius-lg); box-shadow: var(--myts-shadow-lg); }
  .meta { color: var(--myts-muted); margin-bottom: 1rem; }
  .lede { font-size: 1.15rem; }
  .prose :global(p) { margin-bottom: 1rem; }
  .body h1 { margin-top: 0.5rem; }
  .eyebrow-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .eyebrow-row .eyebrow { margin-bottom: 0; }
  .breadcrumb { margin-bottom: 1.25rem; font-size: 0.9rem; }
  .breadcrumb a { color: var(--myts-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--myts-primary); }
  .prog-pdf .btn { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ext-icon { flex: none; opacity: 0.85; margin-top: -1px; }
</style>
