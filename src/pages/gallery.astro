---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const gallery = (await getCollection('gallery')).sort((a, b) => b.data.year - a.data.year);
---
<BaseLayout title="Gallery" description="Photos and video from past MYTS productions.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>Past productions</h1>
      {gallery.length === 0 ? (
        <p>Photos from past shows will appear here.</p>
      ) : (
        <div class="card-grid" style="margin-top: 1.5rem;">
          {gallery.map(item => (
            <figure class="gallery-item">
              <Image src={item.data.cover} alt={item.data.title} width={800} height={600} loading="lazy" />
              <figcaption>
                <strong>{item.data.title}</strong>
                <span>{item.data.year}</span>
                {item.data.credits && <em>{item.data.credits}</em>}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-item {
    margin: 0;
    background: var(--myts-surface);
    border-radius: var(--myts-radius-lg);
    overflow: hidden;
    box-shadow: var(--myts-shadow);
  }
  .gallery-item img { aspect-ratio: 4/3; object-fit: cover; }
  figcaption {
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.9rem;
  }
  figcaption span { color: var(--myts-muted); }
  figcaption em { color: var(--myts-muted); font-size: 0.85rem; }
</style>
