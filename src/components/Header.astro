---
import { SITE } from '../consts';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/shows/', label: 'Shows' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-mark">M</span>
      <span class="brand-name">{SITE.short}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map(item => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--myts-surface);
    border-bottom: 1px solid var(--myts-border);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--myts-primary);
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 34px; height: 34px;
    border-radius: 8px;
    background: var(--myts-primary);
    color: var(--myts-accent);
    font-family: var(--myts-font-display);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .brand-name {
    font-family: var(--myts-font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }
  nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    padding: 0; margin: 0;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
    color: var(--myts-text);
    font-weight: 500;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current="page"] {
    color: var(--myts-primary);
    border-bottom-color: var(--myts-accent);
  }
  nav a:hover { color: var(--myts-primary); }
  @media (max-width: 520px) {
    .header-inner { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    nav ul { gap: 0.9rem; }
  }
</style>
