---
import { Image } from 'astro:assets';
type Props = {
  slug: string;
  title: string;
  dates_start: Date;
  dates_end?: Date;
  venue: string;
  ticket_url?: string;
  poster?: any;
  blurb?: string;
};
const { slug, title, dates_start, dates_end, venue, ticket_url, poster, blurb } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const dateLabel = dates_end && dates_end.getTime() !== dates_start.getTime()
  ? `${fmt(dates_start)} – ${fmt(dates_end)}`
  : fmt(dates_start);
---
<article class="upcoming-show">
  <a href={`/shows/${slug}/`} class="upcoming-media">
    {poster ? (
      <Image src={poster} alt={`${title} poster`} width={400} height={533} loading="lazy" />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <span>{title}</span>
      </div>
    )}
  </a>
  <div class="upcoming-details">
    <p class="eyebrow">{dateLabel}</p>
    <h3><a href={`/shows/${slug}/`}>{title}</a></h3>
    <p class="meta">{venue}</p>
    {blurb && <p class="blurb">{blurb}</p>}
    <div class="upcoming-actions">
      <a href={`/shows/${slug}/`} class="btn btn-outline">Show details</a>
      {ticket_url && (
        <a href={ticket_url} class="btn btn-primary" target="_blank" rel="noopener">Book tickets</a>
      )}
    </div>
  </div>
</article>

<style>
  .upcoming-show {
    display: grid;
    grid-template-columns: minmax(160px, 260px) 1fr;
    background: var(--myts-surface);
    border: 1px solid var(--myts-border);
    border-radius: var(--myts-radius-lg);
    box-shadow: var(--myts-shadow);
    overflow: hidden;
  }
  .upcoming-media {
    display: block;
    aspect-ratio: 3 / 4;
    background: var(--myts-primary);
    overflow: hidden;
  }
  .upcoming-media img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--myts-accent);
    font-family: var(--myts-font-display);
    font-size: 1.25rem;
    text-align: center;
    padding: 1rem;
    background: linear-gradient(135deg, #5b1e40 0%, #3a1329 100%);
  }
  .upcoming-details {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
  }
  .upcoming-details h3 { margin: 0; }
  .upcoming-details h3 a { text-decoration: none; }
  .meta { color: var(--myts-muted); margin: 0; font-size: 0.9rem; }
  .blurb { margin: 0.2rem 0 0; }
  .upcoming-actions { display: flex; gap: 0.75rem; margin-top: 0.85rem; flex-wrap: wrap; }

  @media (max-width: 640px) {
    .upcoming-show { grid-template-columns: 1fr; }
    .upcoming-media { aspect-ratio: 16 / 9; }
  }
</style>
