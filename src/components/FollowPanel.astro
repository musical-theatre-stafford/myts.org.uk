---
import { SOCIALS } from '../consts';

const items = [
  { key: 'facebook',  url: SOCIALS.facebook,  label: 'Facebook',
    path: 'M22 12a10 10 0 1 0-11.56 9.88v-6.99h-2.54V12h2.54V9.8c0-2.51 1.5-3.9 3.78-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z' },
  { key: 'instagram', url: SOCIALS.instagram, label: 'Instagram',
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.42a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.42 2.17 8.8 2.16 12 2.16Zm0 1.8c-3.14 0-3.51.01-4.75.07-.99.04-1.52.21-1.88.35-.47.18-.8.4-1.16.75-.35.35-.57.69-.75 1.16-.14.36-.31.89-.35 1.88-.06 1.24-.07 1.61-.07 4.75s.01 3.51.07 4.75c.04.99.21 1.52.35 1.88.18.47.4.8.75 1.16.35.35.69.57 1.16.75.36.14.89.31 1.88.35 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c.99-.04 1.52-.21 1.88-.35.47-.18.8-.4 1.16-.75.35-.35.57-.69.75-1.16.14-.36.31-.89.35-1.88.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.04-.99-.21-1.52-.35-1.88a3.12 3.12 0 0 0-.75-1.16 3.12 3.12 0 0 0-1.16-.75c-.36-.14-.89-.31-1.88-.35-1.24-.06-1.61-.07-4.75-.07Zm0 3.06a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm5.2-3.1a1.17 1.17 0 1 1 0 2.34 1.17 1.17 0 0 1 0-2.34Z' },
  { key: 'tiktok',    url: SOCIALS.tiktok,    label: 'TikTok',
    path: 'M20 8.4a7 7 0 0 1-4.1-1.3v7.7a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v3a3 3 0 1 0 2.1 2.8V2h3a4 4 0 0 0 4 4v2.4Z' },
  { key: 'youtube',   url: SOCIALS.youtube,   label: 'YouTube',
    path: 'M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 4 12 4 12 4s-7.5 0-9.4.4A3 3 0 0 0 .5 6.5C.1 8.4.1 12 .1 12s0 3.6.4 5.5a3 3 0 0 0 2.1 2.1C4.5 20 12 20 12 20s7.5 0 9.4-.4a3 3 0 0 0 2.1-2.1c.4-1.9.4-5.5.4-5.5s0-3.6-.4-5.5ZM9.75 15.5v-7L15.5 12l-5.75 3.5Z' },
].filter(i => i.url && i.url.trim().length > 0);
---
{items.length > 0 && (
  <section class="section follow-panel">
    <div class="container">
      <p class="eyebrow">Follow us</p>
      <h2>Keep up with MYTS on social media</h2>
      <div class="follow-grid">
        {items.map(item => (
          <a class="follow-card" href={item.url} target="_blank" rel="noopener">
            <span class="follow-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.path} fill="currentColor"/></svg>
            </span>
            <span class="follow-label">{item.label}</span>
            <span class="follow-cta">Follow us &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .follow-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .follow-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 2rem 1.25rem;
    background: var(--myts-surface);
    border: 1px solid var(--myts-border);
    border-radius: var(--myts-radius-lg);
    box-shadow: var(--myts-shadow);
    color: var(--myts-text);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .follow-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.12);
  }
  .follow-icon {
    display: inline-grid;
    place-items: center;
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--myts-primary);
    color: var(--myts-primary-ink);
  }
  .follow-icon svg { width: 28px; height: 28px; }
  .follow-label { font-family: var(--myts-font-display); font-size: 1.1rem; }
  .follow-cta { color: var(--myts-primary); font-weight: 600; font-size: 0.9rem; }
</style>
