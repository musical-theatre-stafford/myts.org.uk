---
/*
 * Photo gallery for an archive show. Reads the photo list (from the manifest)
 * and builds R2 URLs: thumb → grid, display → lightbox, original → download link.
 * Masonry via CSS columns (no JS needed for layout); the lightbox is a small
 * self-contained vanilla script (CSP-safe, no external libs).
 */
import { MEDIA } from '../consts';
const { slug, photos } = Astro.props;
const base = MEDIA.base;
const thumb = (p) => `${base}/_web/${slug}/thumb/${p.name}.webp`;
const display = (p) => `${base}/_web/${slug}/display/${p.name}.webp`;
const original = (p) => `${base}/${slug}/${p.name}.${p.ext}`;
---
<section class="gallery" data-gallery>
  <h2>Photos <span class="count">{photos.length}</span></h2>
  <div class="masonry">
    {photos.map((p) => (
      <button
        type="button"
        class="cell"
        data-display={display(p)}
        data-original={original(p)}
      >
        <img src={thumb(p)} alt="" loading="lazy" width={p.w} height={p.h} />
      </button>
    ))}
  </div>
</section>

<!-- Lightbox overlay (hidden until opened) -->
<div class="lb" data-lb hidden>
  <button class="lb-close" data-lb-close aria-label="Close">&times;</button>
  <button class="lb-nav lb-prev" data-lb-prev aria-label="Previous">&#8249;</button>
  <img class="lb-img" data-lb-img alt="" />
  <button class="lb-nav lb-next" data-lb-next aria-label="Next">&#8250;</button>
  <a class="lb-original" data-lb-original target="_blank" rel="noopener">View full-size original &rarr;</a>
</div>

<style>
  .gallery { margin-top: 2.5rem; border-top: 1px solid var(--myts-border); padding-top: 1.5rem; }
  .gallery h2 .count {
    font-size: 0.85rem; font-weight: 600; color: var(--myts-primary-ink);
    background: var(--myts-primary); border-radius: 999px; padding: 0.1rem 0.6rem; vertical-align: middle;
  }
  .masonry { columns: 4 200px; column-gap: 0.6rem; margin-top: 1.25rem; }
  .cell {
    display: block; width: 100%; padding: 0; margin: 0 0 0.6rem; border: 0; cursor: zoom-in;
    background: var(--myts-border); border-radius: 8px; overflow: hidden; break-inside: avoid; line-height: 0;
  }
  .cell img { width: 100%; height: auto; display: block; transition: opacity 0.15s ease; }
  .cell:hover img { opacity: 0.9; }
  .cell:focus-visible { outline: 3px solid var(--myts-accent); outline-offset: 2px; }

  .lb {
    position: fixed; inset: 0; z-index: 100; background: rgba(8, 20, 22, 0.94);
    display: grid; grid-template-columns: auto 1fr auto; grid-template-rows: 1fr auto;
    align-items: center; padding: 1rem;
  }
  .lb[hidden] { display: none; }
  .lb-img { grid-column: 2; grid-row: 1; max-width: 100%; max-height: 82vh; margin: 0 auto; border-radius: 6px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); }
  .lb-nav { grid-row: 1; background: none; border: 0; color: #fff; font-size: 3rem; cursor: pointer; padding: 0 1rem; opacity: 0.7; }
  .lb-nav:hover { opacity: 1; }
  .lb-prev { grid-column: 1; }
  .lb-next { grid-column: 3; }
  .lb-close { position: absolute; top: 0.75rem; right: 1rem; background: none; border: 0; color: #fff; font-size: 2.4rem; line-height: 1; cursor: pointer; opacity: 0.8; }
  .lb-close:hover { opacity: 1; }
  .lb-original { grid-column: 1 / -1; grid-row: 2; text-align: center; color: var(--myts-accent); margin-top: 0.75rem; font-size: 0.9rem; }
  @media (max-width: 640px) {
    .masonry { columns: 2 140px; }
    .lb-nav { font-size: 2rem; padding: 0 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cell img { transition: none; } }
</style>

<script>
  const root = document.querySelector('[data-gallery]');
  const lb = document.querySelector('[data-lb]');
  if (root && lb) {
    const cells = [...root.querySelectorAll('.cell')];
    const img = lb.querySelector('[data-lb-img]');
    const orig = lb.querySelector('[data-lb-original]');
    let i = 0;
    const show = (n) => {
      i = (n + cells.length) % cells.length;
      const c = cells[i];
      img.src = c.dataset.display;
      orig.href = c.dataset.original;
    };
    const open = (n) => { show(n); lb.hidden = false; document.body.style.overflow = 'hidden'; };
    const close = () => { lb.hidden = true; img.src = ''; document.body.style.overflow = ''; };
    cells.forEach((c, n) => c.addEventListener('click', () => open(n)));
    lb.querySelector('[data-lb-close]').addEventListener('click', close);
    lb.querySelector('[data-lb-prev]').addEventListener('click', () => show(i - 1));
    lb.querySelector('[data-lb-next]').addEventListener('click', () => show(i + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  }
</script>
